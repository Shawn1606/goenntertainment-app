{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    // Die Tests in src/domain laufen direkt mit `node --test` (Node 22+ liest
    // TypeScript nativ). Node braucht dort die vollstaendige Dateiendung im
    // Import – genau das erlaubt diese Option.
    "allowImportingTsExtensions": true,
    // TypeScript 6 bindet @types-Pakete nicht mehr von selbst ein. Die Tests
    // brauchen die Node-Typen (node:test, node:assert, import.meta.dirname).
    "types": ["node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
