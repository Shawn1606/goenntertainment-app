# Vorlage fuer deploy/.env – DIESE Datei kommt auf den Server, nicht ins Git.
#
# Kopieren:  cp .env.example .env    und dann ausfuellen.

# Domain, unter der das Backend erreichbar sein soll. MUSS per DNS-A-Eintrag auf
# die IP des Servers zeigen, BEVOR du `docker compose up -d` startest – Caddy holt
# das Zertifikat nur, wenn Let's Encrypt die Domain schon findet.
# Ohne Punkt-Praefix geht auch, z. B. goenntertainment.de – aber ein eigener
# Unterbereich fuer die API ist sauberer:
DOMAIN=api.goenntertainment.de

# Datenbank-Passwoerter. Frei erfinden, aber lang. Erzeugen z. B. mit:
#   openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- KI-Verifizierung (Jugendschutz) ---------------------------------------
# Ohne Key ist die Pruefung AUS und alle Uploads gehen ungeprueft durch.
# Bei einer oeffentlich erreichbaren App mit fremden Nutzer:innen willst du den
# Key gesetzt haben.
ANTHROPIC_API_KEY=

# Standardwerte stehen in server/.env.example und im Compose. Nur setzen, wenn du
# abweichen willst:
# MODERATION_ENABLED=true
# MODERATION_BLOCK_SEVERITY=2
# MODERATION_FAIL_OPEN=true

# --- Admin-Konto -----------------------------------------------------------
# Nur noetig, wenn du nach dem ersten Start `npm run seed` im Container laufen
# laesst (siehe README.md). Leer lassen => kein Admin wird angelegt.
ADMIN_EMAIL=
ADMIN_PASSWORD=
