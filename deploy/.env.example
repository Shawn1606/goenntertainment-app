# Vorlage für deploy/.env – DIESE Datei kommt auf den Server, nicht ins Git.
#
# Kopieren:  cp .env.example .env    und dann ausfüllen.

# --- Pflicht ---------------------------------------------------------------

# Domain, unter der die App ihr Backend erreicht. MUSS per DNS-A-Eintrag auf die
# IP des Servers zeigen, BEVOR du `docker compose up -d` startest – Caddy holt
# das Zertifikat nur, wenn Let's Encrypt die Domain schon findet.
DOMAIN=api.goenntertainment.de

# Datenbank-Passwörter. Frei erfinden, aber lang. Erzeugen z. B. mit:
#   openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Schlüssel, mit dem Laravel verschlüsselt (u. a. die Geheimnisse der
# Zwei-Faktor-Anmeldung). Erzeugen mit:
#   echo "base64:$(openssl rand -base64 32)"
# EINMAL erzeugen und nie wieder ändern: Mit einem neuen Schlüssel lassen sich
# gespeicherte 2FA-Geheimnisse nicht mehr lesen, und alle mit 2FA kämen nicht
# mehr in ihr Konto.
APP_KEY=

# Shared secret between Laravel (api) and Node (node) for Node's internal routes, e.g. deleting
# an account. Generate it once, at least 32 characters:
#   openssl rand -hex 32
NODE_INTERNAL_SECRET=

# The containers' private network: the first three parts of a /24 that is not used on this
# host (check with `ip -4 addr` and `docker network inspect`), e.g. 172.30.42 for 172.30.42.0/24.
# caddy gets .10 and api .20; each backend trusts the client address only from the one in front.
APP_NET_PREFIX=

# --- Retention (required, an operator decision) ----------------------------
# How many days data that is no longer needed is kept; node deletes it every hour after that
# (server/src/retention.js; `docker compose exec node npm run prune` runs it once). There are no
# defaults: decide each value, then node starts. Whole days.
#   EVIDENCE_RETENTION_DAYS           evidence images of bans and AI moderation reports (the
#                                     image goes, the record stays). Applies to active bans too.
#   MODERATION_REPORT_RETENTION_DAYS  the AI moderation log, which copies every checked text and
#                                     image.
#   TOKEN_RETENTION_DAYS              expired sign-in tokens and two-factor/reset challenges, counted
#                                     from their expiry (at least 1).
#   USAGE_RETENTION_DAYS              event views and active days (at least 120, the streak window;
#                                     older event views no longer count in view numbers).
EVIDENCE_RETENTION_DAYS=
MODERATION_REPORT_RETENTION_DAYS=
TOKEN_RETENTION_DAYS=
USAGE_RETENTION_DAYS=

# --- Mail (für 2FA-Codes und „Passwort vergessen") ------------------------
# Ohne Mail-Zugang läuft alles, nur E-Mail-Codes kommen nicht an – die App meldet
# dann „Wir konnten dir gerade keinen Code schicken". Beispiel Brevo (gratis bis
# 300 Mails/Tag): Host smtp-relay.brevo.com, Port 587.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Absender. Leer = noreply@<DOMAIN>.
MAIL_FROM_ADDRESS=

# --- KI-Verifizierung (Jugendschutz) ---------------------------------------
# REQUIRED: the stack does not start without it, and the node service refuses to run without
# moderation (MODERATION_ENABLED=false is refused too). Whose provider account and key this is,
# and the moderation policy, are the operator's decisions: fill in a key once that is decided.
ANTHROPIC_API_KEY=

# Standardwerte stehen in server/.env.example und im Compose. Nur setzen, wenn du
# abweichen willst:
# MODERATION_BLOCK_SEVERITY=2
# When the model cannot be asked, content is refused (fail closed). Only during a provider
# outage, and on purpose, may this be set to true: content then goes through unchecked.
# MODERATION_FAIL_OPEN=false

# --- Sessions (optional) ----------------------------------------------------
# Access tokens end this many minutes after sign-in; then the app asks to sign in again.
# Default (unset): 43200 = 30 days. Only a positive whole number is accepted.
# Both api and node read this value and refuse a token issued longer ago, so a lower value
# also ends older sessions as soon as the containers run with it (docker compose up -d).
# SANCTUM_EXPIRATION=43200

# --- Admin-Konto -----------------------------------------------------------
# Nur nötig, wenn du nach dem ersten Start das Seed-Skript laufen lässt (siehe
# README.md, Schritt 6). Leer lassen => kein Admin wird angelegt.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Ausgeblendete Funktionen (siehe server/src/features.js) ---------------
# FEATURE_IMPORTED_EVENTS=true
# FEATURE_ACCOUNT_TIERS=true

# --- Write limits (optional, server/src/rate-limit.js) ---------------------
# Per route class, rules scope:max/window (user = per account, ip = per client address; window
# in s, m, h or d). Unset = the code's defaults. Only set a class to deviate, for example:
# WRITE_LIMIT_MODERATED=user:10/1h,user:30/1d,ip:60/1h,ip:300/1d
# Classes: MODERATED, COMMENT, CHAT, REACTION, RELATIONSHIP, BLOCK, REPORT, STATE, CONTENT,
# ACCOUNT, ADMIN, WEBHOOK. An invalid value stops Node's start.

# --- Auth limits (optional, api/config/ratelimits.php) ----------------------
# Sign-up, sign-in, password and two-factor routes; rules max/seconds, comma-separated (for
# example 10/600,30/3600 = at most 10 in 10 minutes and 30 in an hour). Unset or empty = the
# code's defaults (api/.env.example shows them). An invalid value stops the api container's
# start. Variables:
# AUTH_LIMIT_REGISTER_IP, AUTH_LIMIT_REGISTER_ACCOUNT, AUTH_LIMIT_LOGIN_ACCOUNT_IP,
# AUTH_LIMIT_LOGIN_IP, AUTH_LIMIT_LOGIN_ACCOUNT, AUTH_LIMIT_FORGOT_IP, AUTH_LIMIT_FORGOT_ACCOUNT,
# AUTH_LIMIT_RESET_IP, AUTH_LIMIT_RESET_ACCOUNT, AUTH_LIMIT_2FA_CHALLENGE, AUTH_LIMIT_2FA_IP,
# AUTH_LIMIT_2FA_ACCOUNT, AUTH_LIMIT_2FA_RESEND_IP, AUTH_LIMIT_2FA_RESEND_ACCOUNT,
# AUTH_LIMIT_2FA_SETUP_USER, AUTH_LIMIT_ACCOUNT_SENSITIVE_USER, AUTH_LIMIT_PROFILE_USER,
# AUTH_LIMIT_2FA_FAILURES, AUTH_LIMIT_LOCK_WAIT (seconds a request waits for a limiter lock)
