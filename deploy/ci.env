# CI-ONLY settings for deploy/docker-compose.yml. NOT for any real server.
#
# Used by .github/workflows/docker.yml, and by anyone who starts the stack locally for a
# smoke test (from deploy/):
#   docker compose --env-file ci.env -f docker-compose.yml -f docker-compose.ci.yml up -d --build db node api
#
# Every value here is public and fake on purpose. A real server gets its own deploy/.env
# (see deploy/README.md); never copy a value from this file. Secret-like settings carry the
# marker "not-a-secret" in their value (checked by scripts/ci/check-workflows.mjs).
# Settings that later changes make required get a labelled ci-only value here as well.
DOMAIN=ci.example.invalid
DB_PASSWORD=ci-only-not-a-secret-db
DB_ROOT_PASSWORD=ci-only-not-a-secret-root
# Exactly 32 characters, the key length Laravel's AES-256 cipher needs (a raw key without
# the base64: prefix is valid). The CI workflow replaces it with a fresh random key for
# every run; it is here only so this file alone is enough for `docker compose config` and
# a local smoke test.
APP_KEY=ci-only-fake-key-not-a-secret-00
# Shared secret between api and node for Node's internal routes (at least 32 characters).
NODE_INTERNAL_SECRET=ci-only-internal-secret-not-a-secret-0000
# First three parts of the stack's private /24 network (fixed proxy addresses; see the compose).
APP_NET_PREFIX=172.30.99
