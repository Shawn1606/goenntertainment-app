# TEST AND CI ONLY - never use these values in a deployment.
#
# Loaded by `npm test` (node --env-file=test/test.env); a value already set in the environment
# wins. Run single files the same way: node --env-file=test/test.env --test test/<file>.test.js
#
# The suites test what the routes do, not the AI's verdict, so AI moderation is switched off for
# them. Moderation itself (fail closed, the data sent to the model) is tested in
# test/moderation.test.js against a local stand-in for the provider. Production refuses to start
# with this switch (src/config.js).
MODERATION_ENABLED=false
