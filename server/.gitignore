node_modules/
.env

# Hochgeladene Dateien sind Laufzeit-Daten, keine Quellen: echte Nutzerbilder
# (und unter evidence/ gerade die abgelehnten) gehoeren nicht in die Historie.
# ALLES unter storage/ ist ausgeschlossen, nicht nur bekannte Ordner: Laravel
# legt in der Entwicklung selbst neue an (avatars/, partners/, offers/ –
# api/config/filesystems.php), und das Repository ist oeffentlich.
storage-private/
storage/*
!storage/banners/
storage/banners/*
!storage/banners/.gitkeep
