# Datenbank (dieselbe MySQL wie das alte Laravel-Backend)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=goenntertainment
DB_USERNAME=root
DB_PASSWORD=

# Server port. In development Laravel (api/) runs in front on 8000 and forwards to this server
# on 8001 (NODE_FALLBACK_URL in api/.env); the app talks to Laravel only. (The container sets its
# own port, see deploy/docker-compose.yml.)
PORT=8001

# The one hop whose X-Forwarded-For counts (src/config.js): Laravel. In development Laravel
# (`php artisan serve`) calls this server on 127.0.0.1, hence loopback. Required in production,
# where the compose sets Laravel's container address.
NODE_TRUST_PROXY=loopback

# Shared secret for the internal routes Laravel calls (src/routes/internal.js), at least 32
# characters. This is the dev-only value of api/.env.example (both must be equal). Required in
# production, where it is generated (deploy/.env.example); empty = the internal routes refuse
# every call, and deleting an account fails.
NODE_INTERNAL_SECRET=dev-only-internal-secret-not-a-secret-000

# Optional: access tokens end this many minutes after sign-in (src/config.js). The same setting
# as in api/.env, and it must have the same value there: both backends refuse a token issued
# longer ago. Default (unset): 43200 = 30 days; only a positive whole number is accepted.
# SANCTUM_EXPIRATION=43200

# Retention in days (src/retention.js, F-16): required in production, where they are an operator
# decision (deploy/.env.example). Outside production all four or none: unset = nothing is pruned.
# DEV-ONLY example values below, NOT a retention decision; uncomment to try the prune locally
# (the server prunes at start and hourly; `npm run prune` runs it once).
# EVIDENCE_RETENTION_DAYS=30
# MODERATION_REPORT_RETENTION_DAYS=30
# TOKEN_RETENTION_DAYS=1
# USAGE_RETENTION_DAYS=120

# Optional: write limits per route class (src/rate-limit.js), rules scope:max/window
# (user = per account, ip = per client address; window in s, m, h or d). Unset = the code's
# defaults; an invalid value stops the start. For example:
# WRITE_LIMIT_MODERATED=user:10/1h,user:30/1d,ip:60/1h,ip:300/1d

# Optional: feste oeffentliche Basis-URL fuer Banner-Bilder.
# Leer lassen => wird aus der Anfrage (Host) automatisch bestimmt.
PUBLIC_URL=

# Admin-Konto fuer `npm run seed` (Admin-Panel). Leer lassen => Admin wird uebersprungen.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- KI-Verifizierung (Jugendschutz) ---------------------------------------
# The AI moderation fails closed: without a key, or when the model cannot be reached, every
# checked post, image, story and event is refused (unless MODERATION_FAIL_OPEN=true below).
# Production (NODE_ENV=production) does not start without a key.
# Key anlegen: https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# DEVELOPMENT ONLY: moderation switched off, so local work without a key is possible. Set it to
# true (or remove the line) once a key is set. Production refuses to start with false.
MODERATION_ENABLED=false

# Modell fuer die Pruefung (Bild + Text).
MODERATION_MODEL=claude-opus-5

# Schwere-Skala der KI: 0 unbedenklich | 1 grenzwertig | 2 nicht jugendfrei | 3 schwer
# Ab dieser Schwere wird der Inhalt abgelehnt:
MODERATION_BLOCK_SEVERITY=2
# Ab dieser Schwere wird das Konto zusaetzlich automatisch gesperrt
# (auf 3 setzen = nur bei schweren Faellen sperren, sonst nur ablehnen):
MODERATION_TIMEOUT_SEVERITY=2
# Dauer der automatischen Sperre in Tagen:
MODERATION_TIMEOUT_DAYS=7

# When the model cannot be asked (no key, outage, timeout): false (the default) refuses the
# content; only exactly true lets it through unchecked - an explicit emergency switch. A request
# the provider itself refuses (a 4xx other than 408 and 429) is refused whatever this says.
MODERATION_FAIL_OPEN=false

# Global budget of AI moderation calls per UTC day across all accounts (src/moderation.js, F-07):
# a whole number of at least 1, required in production, where it is an operator decision (no
# default). Outside production unset means no cap, and nothing is counted. Beyond the limit every
# checked write is refused until the next UTC day, whatever MODERATION_FAIL_OPEN says.
# DEV-ONLY example value below, NOT a spending decision; uncomment to try the cap locally.
# MODERATION_DAILY_CALL_LIMIT=100

# Zeitlimit fuer einen Pruef-Aufruf in Millisekunden.
MODERATION_TIMEOUT_MS=45000

# Server-seitiges Ersatzmodell, falls Anthropic die Pruefanfrage selbst ablehnt.
# Ist die Beta fuer den Account nicht frei, schaltet der Server sie selbst ab.
MODERATION_FALLBACKS=true
